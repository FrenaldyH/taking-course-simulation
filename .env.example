# Salin berkas ini menjadi .env, lalu isi dengan kredensial PostgreSQL kamu.
# Perintah: cp .env.example .env
#
# Hanya dipakai oleh contoh 05 dan 06 yang menyentuh database.
# Contoh 01 sampai 04 jalan tanpa berkas ini.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=alpro_db
